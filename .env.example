REPLICATE_API_TOKEN=your_replicate_api_token
# idm-vton (default) or oot-diffusion. Versions live in tryon.config.json.
TRYON_MODEL=idm-vton
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
DAILY_TRYON_LIMIT=200
# Local development only; ignored when NODE_ENV=production.
DISABLE_SPEND_GUARD=0
DAILY_LLM_LIMIT=200
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# Optional legacy bucket name used only to read older closet image records.
CLOSET_GARMENTS_BUCKET=closet-garments
OPENAI_API_KEY=your_server_only_openai_api_key
OPENAI_VOICE_MODEL=gpt-4o-mini
OPENAI_STYLE_MODEL=gpt-4.1
ANTHROPIC_API_KEY=your_server_only_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-5-5
SERPAPI_API_KEY=your_server_only_serpapi_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the Python Moss voice service. The Moss credentials belong only in python-agent/.env.
MOSS_VOICE_SERVICE_URL=http://localhost:8001
# Generate a long random value and use the same value in python-agent/.env.
VOICE_TOOLS_SHARED_SECRET=replace_with_a_random_32_byte_secret
PROFILE_SESSION_SECRET=replace_with_a_different_random_32_byte_secret
DEMO_OFFLINE=0

# Checkout estimates and server-side Visa token adapter. Never add card number/CVV fields.
CHECKOUT_TAX_RATE=0.0825
CHECKOUT_SHIPPING_PER_RETAILER_CENTS=695
VISA_CHECKOUT_ENABLED=0
# Your sponsor/acquirer adapter must use Visa APIs and retailer order APIs; server only.
VISA_CHECKOUT_ADAPTER_URL=https://your-private-checkout-adapter.example
VISA_CHECKOUT_ADAPTER_SECRET=replace_with_adapter_service_secret
# The adapter resolves the signed user profile to that user's token in the sponsor vault.
